// Secrets this app needs (add them in Cloudflare: Worker > Settings > Variables and Secrets):
//   DATABASE_URL
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "focusread",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/index.html"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
